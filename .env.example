# =====================================================
# COMUNAS — Variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# NUNCA commitees tu .env real al repositorio.
# =====================================================

# Supabase (Postgres + Auth + Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (mail de invitación de usuarios, con identidad del municipio
# en vez de la plantilla genérica de Supabase Auth — ver api/invite-user.js)
RESEND_API_KEY=

# Twilio (SMS notificaciones a vecinos)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google OAuth (login con cuenta de Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Plan B (integración API)
PLANB_API_KEY=
PLANB_PARTNER_KEY=
INTERNAL_SYNC_KEY=

# Secreto del Database Webhook de Supabase que llama a api/notificar-turno.js
# (header x-webhook-secret) — ver NOTIFICACIONES-WEBHOOK-SETUP.md
SUPABASE_WEBHOOK_SECRET=

# Anthropic Claude (asistente IA)
ANTHROPIC_API_KEY=

# App
VITE_APP_NAME=COMUNAS
